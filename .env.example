# ============================================================
# GovCon Operator — Environment Configuration
# Copy to .env.local for local development: cp .env.example .env.local
#
# The app runs zero-config out of the box: with none of these set it uses
# the built-in demo auth, mock AI, and mock data. Fill sections in as you
# connect real services.
# ============================================================

# ------------------------------------------------------------
# Authentication
# ------------------------------------------------------------
# AUTH_PROVIDER controls how sign-in works:
#   (unset)  -> demo auth if Cognito is not configured, otherwise Cognito
#   mock     -> force the built-in demo auth (any credentials sign in)
#   cognito  -> force AWS Cognito (requires the COGNITO_* values below)
AUTH_PROVIDER=mock

# Secret used to sign demo-mode session tokens. Change this in any shared
# environment. Ignored when AUTH_PROVIDER=cognito.
AUTH_SECRET=change-me-in-production

# AWS Cognito (only needed when using real auth)
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# ------------------------------------------------------------
# Database (PostgreSQL)
# ------------------------------------------------------------
# Optional for a read-only demo (the app falls back to mock data), required
# to persist saved opportunities, analyses, workflows, etc.
# Local Postgres via docker-compose:
#   docker compose up -d
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/govcon_operator?schema=public"

# ------------------------------------------------------------
# AI Service
# ------------------------------------------------------------
# AI_PROVIDER: mock (default) | openai | bedrock
AI_PROVIDER=mock
AI_MODEL=gpt-4o-mini
OPENAI_API_KEY=

# ------------------------------------------------------------
# Integrations
# ------------------------------------------------------------
# SAM.gov opportunity search — https://open.gsa.gov/api/get-opportunities-public-api/
SAM_GOV_API_KEY=

# ------------------------------------------------------------
# AWS (S3 document storage + region)
# ------------------------------------------------------------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_REGION=us-east-1
