# ============================================================
# GovCon Operator - Environment Variables
# ============================================================

# Database (PostgreSQL on AWS RDS; matches docker-compose.yml for local dev)
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/govcon_operator"

# AWS General
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key

# AWS Cognito Authentication
# Set GOVCON_DEMO_AUTH=true for local seeded demo auth. Use false with real Cognito.
GOVCON_DEMO_AUTH=true
# Test-only override for `next start` and CI. Never enable on a public deployment.
GOVCON_DEMO_AUTH_ALLOW_PRODUCTION_BUILD=false
# Production and CI should fail instead of silently returning mock data.
GOVCON_STRICT_DATA=false
COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
COGNITO_CLIENT_ID=your-cognito-client-id

# AWS S3 Document Storage
AWS_S3_BUCKET=govcon-operator-documents
AWS_S3_REGION=us-east-1

# AI Service Configuration
# Options: "mock" (default), "openai", "bedrock"
AI_PROVIDER=mock
AI_MODEL=gpt-4o-mini

# OpenAI (required if AI_PROVIDER=openai)
OPENAI_API_KEY=sk-your-openai-api-key

# AWS Bedrock (required if AI_PROVIDER=bedrock)
AWS_BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0

# SAM.gov API Integration
# Get your API key at: https://open.gsa.gov/api/get-opportunities-public-api/
SAM_GOV_API_KEY=your-sam-gov-api-key

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
